<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap narrow">
  <section class="block auth">
    <h1 class="block-title page-h1">My account</h1>
    <p class="muted">Signed in as <strong><%= me.username %></strong> · <a href="/user/<%= encodeURIComponent(me.username) %>">public profile</a> · <a href="/library">library</a></p>
    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
    <h2 class="sub-h">Email</h2>
    <form method="post" action="/account/email">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Email address
        <input name="email" type="email" value="<%= me.email || '' %>" maxlength="200" autocomplete="email" placeholder="you@example.com"></label>
      <% if (me.email) { %><p class="small"><%= me.email_verified ? '✅ Confirmed' : (emailReady ? '⏳ Not confirmed yet. Check your inbox, or click Save to resend the link.' : 'Saved.') %></p><% } %>
      <p class="muted small">Used only to reset your password<% if (emailReady) { %> and confirm it’s you<% } %>. Never shown publicly.</p>
      <button class="btn btn-accent" type="submit">Save email</button>
    </form>
    <h2 class="sub-h">Reading settings</h2>
    <% const p = user.prefs || {}; const has = Object.keys(p).length; %>
    <p class="muted small">Your text size, font, line spacing, page width and colours from the <strong>Aa</strong> button in any chapter are saved to your account, so they’re the same on your phone, tablet and computer.</p>
    <% if (has) { %>
      <p class="small">Saved: <%= [p.theme && `${p.theme} mode`, p.rtheme && `${p.rtheme} page`, p.font && `${p.font === 'dyslexic' ? 'readable' : p.font} font`, p.size && `${p.size}px text`, p.line && `${p.line} line spacing`, p.width && `${p.width}px width`, p.align === 'justify' && 'justified'].filter(Boolean).join(' · ') %></p>
      <form method="post" action="/account/prefs" onsubmit="try { localStorage.removeItem('reader-prefs'); localStorage.removeItem('site-theme'); } catch (e) {}">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="reset" value="1">
        <button class="btn" type="submit">Reset to defaults</button>
      </form>
    <% } else { %><p class="small">Nothing saved yet. Open any chapter and tap <strong>Aa</strong> to set it up.</p><% } %>
    <h2 class="sub-h">Password</h2>
    <form method="post" action="/account/password">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Current password <input name="current" type="password" required autocomplete="current-password"></label>
      <label>New password <input name="password" type="password" minlength="8" required autocomplete="new-password"></label>
      <button class="btn" type="submit">Change password</button>
    </form>
    <h2 class="sub-h">Devices</h2>
    <p class="muted small">Logged in on a shared or lost device? This logs you out everywhere except here.</p>
    <form method="post" action="/account/logout-all" onsubmit="return confirm('Log out on all your other devices?')">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit">Log out all other devices</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
