<%- include('partials/top', { title: 'Dashboard', actions: `<a class="btn btn-primary" href="${A('/upload')}">⬆ Upload chapters</a>` }) %>
<% if (update.running) { %><div class="alert alert-ok">⏳ A site update is in progress… <a href="<%= A('/system') %>">see progress</a></div><% } %>
<% if (wantUpdates.length) { %>
<div class="alert alert-ok" style="display: block">📣 <strong>Readers want new chapters:</strong>
  <% wantUpdates.forEach((n, i) => { %><%= i ? ', ' : '' %><a href="<%= A(`/novels/${n.id}/upload`) %>"><%= n.title %></a> (<%= n.waiting %> waiting)<% }) %>
  · <a href="<%= A('/update-requests') %>">see leaderboard →</a></div>
<% } %>
<div class="stats">
  <% if (people.visitorsToday !== null) { %>
  <div class="stat stat-accent" title="Different people who visited the site today (each person counts once, bots excluded)"><span><%= people.visitorsToday.toLocaleString('en-US') %></span>Unique visitors today</div>
  <div class="stat" title="Unique visitors yesterday · average over the last 7 days"><span><%= people.visitorsYesterday.toLocaleString('en-US') %></span>Yesterday <small class="muted">(7-day avg <%= people.visitorsAvg.toLocaleString('en-US') %>)</small></div>
  <% } %>
  <div class="stat<%= people.visitorsToday === null ? ' stat-accent' : '' %>" title="Different people who opened at least one chapter today"><span><%= people.readersToday.toLocaleString('en-US') %></span>Unique readers today</div>
  <div class="stat"><span><%= stats.today.toLocaleString('en-US') %></span>Views today</div>
  <div class="stat"><span><%= u.compactNumber(stats.week) %></span>Views this week</div>
  <div class="stat"><span><%= stats.novels %></span>Novels</div>
  <div class="stat"><span><%= stats.chapters.toLocaleString('en-US') %></span>Chapters</div>
  <div class="stat"><span><%= u.compactNumber(stats.words) %></span>Words translated</div>
  <div class="stat"><span><%= u.compactNumber(stats.views) %></span>All-time views</div>
  <% if (user.role === 'admin') { %>
  <div class="stat"><span><%= stats.users %></span>Users</div>
  <% } %>
</div>

<div class="quick">
  <a class="quick-card" href="<%= A('/novels/new') %>"><span>➕</span><strong>Add a novel</strong><small>Title, cover, genres, synopsis</small></a>
  <a class="quick-card" href="<%= A('/upload') %>"><span>⬆</span><strong>Batch upload</strong><small>Drop files or paste, preview, publish</small></a>
  <a class="quick-card" href="<%= A('/novels') %>"><span>📚</span><strong>Manage novels</strong><small>Edit details, chapters, delete</small></a>
  <% if (user.role === 'admin') { %>
  <form method="post" action="<%= A('/demo-novel') %>" class="quick-form" onsubmit="return confirm('Add a sample novel (8 short chapters) to try the site with? You can delete it later.')">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="quick-card"><span>🧪</span><strong>Add a test novel</strong><small>A sample with covers, volumes and a scheduled chapter</small></button>
  </form>
  <a class="quick-card" href="<%= A('/settings') %>"><span>🛠</span><strong>Site settings</strong><small>Name, announcement, sign-ups</small></a>
  <% } %>
</div>

<% if (trafficToday && trafficToday.chapter_loads >= 20 && trafficToday.pct >= 30) { %>
<div class="alert alert-error" style="display: block">🕵️ <strong>Possible scraping today:</strong> <%= trafficToday.pct %>% of chapter downloads (<%= trafficToday.unconfirmed.toLocaleString('en-US') %>) were never opened in a browser. They don’t count in your views or visitors. <a href="<%= A('/scraping#scrapers') %>">See the scraper check →</a></div>
<% } %>
<% if (visitorChart) { %>
<div class="grid-2">
  <section class="card">
    <h2>👥 Unique visitors per day <span class="muted small" style="font-weight: 400">whole site, last 30 days</span></h2>
    <%- include('partials/bars', { chart: visitorChart, unit: 'visitors' }) %>
  </section>
  <section class="card">
    <h2>📖 Unique readers per day <span class="muted small" style="font-weight: 400">opened a chapter</span></h2>
    <%- include('partials/bars', { chart: readerChart, unit: 'readers' }) %>
  </section>
</div>
<% } else { %>
<section class="card">
  <h2>📖 Unique readers per day <span class="muted small" style="font-weight: 400">your novels, last 30 days</span></h2>
  <%- include('partials/bars', { chart: readerChart, unit: 'readers' }) %>
</section>
<% } %>
<p class="hint" style="margin: -6px 0 18px">Each person counts once per day (logged-in readers by account, guests by an anonymous code that changes daily). Bots aren’t counted. Counting started with this update.</p>

<section class="card">
  <h2 style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap">🏆 Today’s top novels <a class="small" style="font-weight: 600" href="<%= A('/leaderboard') %>">Full leaderboard →</a></h2>
  <% if (!todayTop.length) { %><p class="muted">No views yet today.</p><% } else { %>
  <table class="table">
    <% todayTop.forEach((n) => { %>
      <tr><td class="rank-cell"><%= n.rank %></td><td><a href="<%= A(`/novels/${n.id}/stats`) %>"><strong><%= n.title %></strong></a></td><td class="right nowrap">👁 <%= n.views.toLocaleString('en-US') %> <span class="muted small">today</span></td></tr>
    <% }) %>
  </table>
  <% } %>
</section>

<div class="grid-2">
  <section class="card">
    <h2>Views, last 30 days</h2>
    <%- include('partials/bars', { chart }) %>
  </section>
  <section class="card">
    <h2>Trending this week</h2>
    <% if (!top.some((n) => n.views_week)) { %><p class="muted">No views yet this week. Share your novels on Discord or Reddit to get readers.</p><% } %>
    <table class="table">
      <% top.filter((n) => n.views_week).forEach((n, i) => { %>
        <tr><td class="rank-cell"><%= i + 1 %></td><td><a href="<%= A(`/novels/${n.id}/stats`) %>"><strong><%= n.title %></strong></a></td><td class="right nowrap">👁 <%= n.views_week.toLocaleString('en-US') %></td></tr>
      <% }) %>
    </table>
  </section>
</div>

<% if (scheduled.length) { %>
<section class="card">
  <h2>⏰ Scheduled releases</h2>
  <table class="table">
    <% scheduled.forEach((c) => { %>
      <tr><td><a href="<%= A(`/novels/${c.novel_id}/chapters`) %>"><%= u.chapterLabel(c) %></a><div class="muted small"><%= c.novel_title %></div></td>
      <td class="right nowrap"><span class="local-time" data-ts="<%= c.publish_at %>"><%= u.formatDate(c.publish_at) %></span></td></tr>
    <% }) %>
  </table>
</section>
<% } %>

<div class="grid-2">
  <section class="card">
    <h2>Your novels <a class="card-link" href="<%= A('/novels') %>">See all →</a></h2>
    <% if (!novels.length) { %>
      <div class="empty-state">
        <p>No novels yet. Start by adding one. It only takes a title.</p>
        <a class="btn btn-primary" href="<%= A('/novels/new') %>">➕ Add your first novel</a>
      </div>
    <% } %>
    <table class="table">
      <% novels.forEach((n) => { %>
        <tr>
          <td><a href="<%= A(`/novels/${n.id}/chapters`) %>"><strong><%= n.title %></strong></a><div class="muted small"><%= n.chapter_count %> ch. · 👁 <%= u.compactNumber(n.views) %> · updated <%= u.timeAgo(n.updated_at) %><%= n.scheduled_count ? ` · ⏰ ${n.scheduled_count} scheduled` : '' %></div></td>
          <td class="right nowrap"><a class="btn btn-sm btn-primary" href="<%= A(`/novels/${n.id}/upload`) %>">⬆ Upload</a> <a class="btn btn-sm" href="<%= A(`/novels/${n.id}/edit`) %>">Edit</a></td>
        </tr>
      <% }) %>
    </table>
  </section>
  <section class="card">
    <h2>Recently published</h2>
    <% if (!recent.length) { %><p class="muted">Nothing published yet.</p><% } %>
    <table class="table">
      <% recent.forEach((c) => { %>
        <tr>
          <td><a href="<%= site(`/novel/${c.slug}/c/${u.formatNumber(c.number)}`) %>" target="_blank" rel="noopener"><%= u.chapterLabel(c) %></a><div class="muted small"><%= c.novel_title %></div></td>
          <td class="right muted small nowrap"><%= u.timeAgo(c.released_at) %><br>👁 <%= c.views %></td>
        </tr>
      <% }) %>
    </table>
  </section>
</div>
<%- include('partials/bottom') %>
