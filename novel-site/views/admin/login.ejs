<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin login · <%= settings.site_name %></title>
<link rel="stylesheet" href="<%= A('/assets/admin.css') %>">
</head>
<body class="login-body">
  <form class="login-card" method="post" action="<%= A('/login') %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="login-logo">⚙</div>
    <h1><%= settings.site_name %></h1>
    <% if (firstRun) { %>
      <p class="muted">Welcome! Create your <strong>owner account</strong> to set up the site. This account gets full admin access.</p>
    <% } else { %>
      <p class="muted">Admin panel sign-in</p>
    <% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <label>Username<input name="username" value="<%= username %>" required autofocus autocomplete="username"></label>
    <label>Password<input name="password" type="password" required <%= firstRun ? 'minlength=8' : '' %> autocomplete="<%= firstRun ? 'new-password' : 'current-password' %>"></label>
    <button class="btn btn-primary btn-block" type="submit"><%= firstRun ? 'Create owner account' : 'Sign in' %></button>
  </form>
</body>
</html>
