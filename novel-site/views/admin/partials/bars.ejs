<% const max = Math.max(1, ...chart.map((d) => d.views)); const total = chart.reduce((a, d) => a + d.views, 0); const unitName = locals.unit || 'views'; const isPeople = unitName !== 'views'; %>
<div class="bars<%= isPeople ? ' bars-people' : '' %>" role="img" aria-label="<%= unitName %> per day for the last <%= chart.length %> days">
  <% chart.forEach((d, i) => { const dt = new Date(d.day + 'T00:00:00Z'); %>
    <div class="bar" title="<%= dt.toUTCString().slice(0, 11) %>: <%= d.views.toLocaleString('en-US') %> <%= unitName %>">
      <span class="bar-fill" style="height: <%= Math.max(d.views ? 3 : 0, Math.round((d.views / max) * 100)) %>%"></span>
      <% if ((chart.length - 1 - i) % 7 === 0) { %><span class="bar-label"><%= dt.getUTCDate() %>/<%= dt.getUTCMonth() + 1 %></span><% } %>
    </div>
  <% }) %>
</div>
<div class="bars-foot muted small"><span>Peak: <%= max === 1 && !chart.some((d) => d.views) ? 0 : max.toLocaleString('en-US') %>/day</span><% if (isPeople) { %><span>Average: <%= Math.round(total / chart.length).toLocaleString('en-US') %> <%= unitName %>/day</span><% } else { %><span>Total: <%= total.toLocaleString('en-US') %> views in <%= chart.length %> days</span><% } %></div>
