<%- include('partials/top', { title: 'Site settings' }) %>
<form method="post" action="<%= A('/settings') %>" class="card settings-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Branding</h2>
  <label class="field">Site name<input name="site_name" value="<%= settings.site_name %>" required maxlength="80"></label>
  <label class="field">Tagline<input name="site_tagline" value="<%= settings.site_tagline %>" maxlength="200"></label>
  <label class="field">Contact email <span class="hint">Shown on the public Contact page and About page (optional: the contact form works without it, and messages arrive under 📨 Messages).</span><input name="contact_email" type="email" value="<%= settings.contact_email %>" maxlength="200" placeholder="hello@travellermtl.com"></label>
  <label class="field">Announcement banner<span class="hint">Shown at the top of every public page. Leave empty to hide.</span><input name="announcement" value="<%= settings.announcement %>" maxlength="1000" placeholder="e.g. Double releases this weekend!"></label>
  <label class="field">Footer text<textarea name="footer_text" rows="2"><%= settings.footer_text %></textarea></label>
  <label class="field">Default look for visitors
    <select name="default_theme"><option value="dark" <%= settings.default_theme !== 'light' ? 'selected' : '' %>>🌙 Dark</option><option value="light" <%= settings.default_theme === 'light' ? 'selected' : '' %>>☀️ Light</option></select>
    <span class="hint">Readers can still switch with the 🌙/☀️ button; their choice is remembered.</span>
  </label>
  <h2>Community</h2>
  <label class="switch"><input type="checkbox" name="allow_registration" value="1" <%= settings.allow_registration === '1' ? 'checked' : '' %>><span></span> Allow new sign-ups</label>
  <label class="switch"><input type="checkbox" name="comments_enabled" value="1" <%= settings.comments_enabled === '1' ? 'checked' : '' %>><span></span> Enable chapter comments</label>
  <label class="field">New accounts start as
    <select name="default_role"><option value="reader" <%= settings.default_role === 'reader' ? 'selected' : '' %>>Reader (recommended)</option><option value="translator" <%= settings.default_role === 'translator' ? 'selected' : '' %>>Translator (can upload immediately)</option></select>
  </label>
  <h2 id="about-page">About us page</h2>
  <p class="hint" style="margin-top: 0">The page at <a href="<%= site('/about') %>" target="_blank" rel="noopener"><%= site('/about').replace(/^https?:\/\//, '') %></a> (linked in the footer). Google and AdSense reviewers read it, so say who runs the site and what it offers.</p>
  <label class="field">Page title <span class="hint">Empty = “About <%= settings.site_name %>”.</span><input name="about_title" value="<%= settings.about_title %>" maxlength="120" placeholder="About <%= settings.site_name %>"></label>
  <label class="field">Page text
    <span class="hint">Write normally. Start a line with <code>## </code> for a heading and <code>- </code> for a bullet; <code>**bold**</code>, <code>*italic*</code>, <code>[link text](https://…)</code>. Leave a blank line between paragraphs. Clear the box and save to go back to the built-in text.</span>
    <textarea name="about_body" rows="18" class="mono" maxlength="30000"><%= settings.about_body || about.DEFAULT_ABOUT %></textarea>
  </label>
  <details class="small" style="margin: -4px 0 12px"><summary>Automatic values you can use in the text</summary>
    <ul style="margin: 6px 0"><% Object.entries(about.PLACEHOLDERS).forEach(([k, v]) => { %><li><code><%= k %></code>: <%= v %></li><% }) %></ul>
  </details>
  <label class="field">Description for Google <span class="hint">The short text under the page in search results (up to 300 characters). Empty = a standard one.</span><input name="about_description" value="<%= settings.about_description %>" maxlength="300"></label>

  <h2 id="public-novels">Public novels</h2>
  <p class="hint" style="margin-top: 0">Novels are <strong>hidden by default</strong>: guests don’t see them anywhere on the site (home page, browse, search); signed-in accounts see everything. Hidden novels <strong>stay on Google</strong>, and anyone with a link (for example from a Google search) can still read them. Tick the novels guests should see on the site. New novels start hidden.</p>
  <input type="hidden" name="novel_visibility" value="1">
  <% if (!novelList.length) { %><p class="muted">No novels yet.</p><% } else { %>
  <div class="public-list">
    <div class="public-tools small"><button type="button" class="linkbtn" data-all="1">Tick all</button> · <button type="button" class="linkbtn" data-all="0">Untick all</button> · <span id="public-count"></span></div>
    <% novelList.forEach((n) => { %>
      <label class="switch"><input type="checkbox" name="public_novels" value="<%= n.id %>" <%= n.members_only ? '' : 'checked' %>><span></span> <%= n.title %></label>
    <% }) %>
  </div>
  <% } %>
  <div class="form-actions"><button class="btn btn-primary btn-lg" type="submit">💾 Save settings</button></div>
</form>
<script>
  (function () {
    var boxes = [].slice.call(document.querySelectorAll('input[name=public_novels]'));
    var count = document.getElementById('public-count');
    function update() { if (count) count.textContent = boxes.filter(function (b) { return b.checked; }).length + ' of ' + boxes.length + ' public'; }
    document.querySelectorAll('[data-all]').forEach(function (b) { b.addEventListener('click', function () { boxes.forEach(function (x) { x.checked = b.dataset.all === '1'; }); update(); }); });
    boxes.forEach(function (b) { b.addEventListener('change', update); });
    update();
  })();
</script>
<%- include('partials/bottom') %>
