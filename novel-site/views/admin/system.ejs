<%- include('partials/top', { title: 'Update & backup' }) %>
<div class="grid-2">
  <section class="card">
    <h2>🔄 Site updates</h2>
    <% if (!info.canUpdate) { %>
      <p class="muted">One-click updates are only available when the site was installed with the install script (from GitHub).</p>
    <% } else { %>
      <p>Current version: <code><%= info.git.commit %></code> <span class="muted small">(<%= info.git.subject %>, <span class="local-time" data-iso="<%= info.git.date %>"><%= info.git.date.slice(0, 10) %></span>)</span></p>
      <% if (update.running) { %>
        <div class="alert alert-ok" id="update-running">⏳ Updating… this page refreshes by itself.</div>
      <% } else if (info.pending === null) { %>
        <a class="btn btn-primary btn-lg" href="<%= A('/system?check=1') %>">🔍 Check for updates</a>
      <% } else if (info.checkError) { %>
        <div class="alert alert-error">Couldn't check for updates: <%= info.checkError %></div>
      <% } else if (!info.pending.length) { %>
        <div class="alert alert-ok">✓ You're on the latest version.</div>
        <a class="btn" href="<%= A('/system?check=1') %>">Check again</a>
      <% } else { %>
        <p><strong><%= info.pending.length %> update<%= info.pending.length === 1 ? '' : 's' %> available:</strong></p>
        <% if (info.whatsNew && info.whatsNew.length) { %>
          <% info.whatsNew.forEach((e) => { %><%- include('partials/changelog-entry', { e, isNew: true }) %><% }) %>
        <% } else { %>
        <ul class="changes"><% info.pending.slice(0, 15).forEach((c) => { %><li><%= c.subject %> <span class="muted small"><%= c.date.slice(0, 10) %></span></li><% }) %></ul>
        <% } %>
        <form method="post" action="<%= A('/system/update') %>" onsubmit="return confirm('Install the update now? The site will be unavailable for a few seconds while it restarts.')">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-primary btn-lg" type="submit">⬆ Install update</button>
        </form>
        <p class="hint">Your novels, chapters, users and settings are kept. Only the site's code changes.</p>
      <% } %>
      <% if (last && !update.running) { %>
        <div class="undo-box">
          <% if (last.undone) { %>
            <p class="muted small">↩ The last update was undone on <span class="local-time" data-ts="<%= Math.round(last.at / 1000) %>"></span>. You're on the earlier version <code><%= last.from.slice(0, 7) %></code>. Installing updates again brings the newer version back.</p>
          <% } else { %>
            <p class="small">Last update installed <span class="local-time" data-ts="<%= Math.round(last.at / 1000) %>"></span> (<code><%= last.from.slice(0, 7) %></code> → <code><%= last.to.slice(0, 7) %></code>). Something wrong since then?</p>
            <form method="post" action="<%= A('/system/undo') %>" onsubmit="return confirm('Go back to the version from before the last update? Your novels, chapters and accounts are kept.')">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn" type="submit">↩ Undo last update</button>
            </form>
          <% } %>
        </div>
      <% } %>
      <% if (update.log.length || update.running) { %><pre class="log" id="update-log"><%= update.log.join('\n') %></pre><% } %>
    <% } %>
  </section>
  <section class="card">
    <h2>💾 Backups</h2>
    <p>Download a complete copy of the database: novels, chapters, users, comments and settings. Keep it somewhere safe (e.g. Google Drive).</p>
    <a class="btn btn-primary" href="<%= A('/system/backup') %>">⬇ Download database backup</a>
    <p class="hint">Database size: <%= info.dbSize ? u.compactNumber(info.dbSize) + 'B' : '?' %>. Cover images are stored separately and are included in the server's automatic nightly backups.</p>
    <h2 style="margin-top:22px">ℹ Server</h2>
    <p class="muted small">Node <%= info.node %> · up for <%= Math.floor(info.uptime / 3600) %>h <%= Math.floor(info.uptime % 3600 / 60) %>m</p>
  </section>
</div>
<section class="card" id="storage">
  <% const mb = (n) => n >= 1073741824 ? (n / 1073741824).toFixed(n >= 10737418240 ? 0 : 1) + ' GB' : n >= 1048576 ? Math.round(n / 1048576) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB';
     const d = storage.disk; const pct = d ? Math.round(d.used / d.total * 100) : 0; const level = pct >= 90 ? 'bad' : pct >= 75 ? 'warn' : 'ok'; %>
  <h2 style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap">💽 Server storage <a class="small" style="font-weight: 600" href="<%= A('/system?refresh=1#storage') %>">↻ Refresh</a></h2>
  <% if (d) { %>
    <div class="st-summary">
      <div><div class="st-big"><%= mb(d.free) %></div><div class="muted small">free of <%= mb(d.total) %></div></div>
      <div><div class="st-big"><%= mb(storage.site) %></div><div class="muted small">used by this site</div></div>
      <div><div class="st-big st-<%= level %>"><%= pct %>%</div><div class="muted small">of the disk used</div></div>
    </div>
    <div class="st-bar" title="Disk: <%= mb(d.used) %> used, <%= mb(d.free) %> free">
      <span class="st-site" style="width: <%= Math.min(100, storage.site / d.total * 100).toFixed(2) %>%"></span><span class="st-other" style="width: <%= Math.max(0, (d.used - storage.site) / d.total * 100).toFixed(2) %>%"></span>
    </div>
    <div class="st-legend small"><span><i class="st-site"></i>This site <%= mb(storage.site) %></span><span><i class="st-other"></i>System &amp; other programs <%= mb(Math.max(0, d.used - storage.site)) %></span><span><i class="st-free"></i>Free <%= mb(d.free) %></span></div>
    <% if (level === 'bad') { %><div class="alert alert-error" style="margin-top: 12px">The disk is almost full. When it fills up the site can stop saving chapters and comments. Delete old backups below, or upgrade the server’s disk in your Hetzner account.</div>
    <% } else if (level === 'warn') { %><div class="alert" style="margin-top: 12px">The disk is getting full. Keep an eye on it, and delete old backups if you need room.</div><% } %>
  <% } else { %><p class="muted">The server’s disk size couldn’t be read.</p><% } %>

  <table class="table" style="margin-top: 14px">
    <thead><tr><th>What</th><th class="right">Size</th></tr></thead>
    <% storage.parts.forEach((p) => { %><tr><td><%= p.label %></td><td class="right nowrap"><strong><%= mb(p.size) %></strong></td></tr><% }) %>
    <tr><td><strong>Total for this site</strong></td><td class="right nowrap"><strong><%= mb(storage.site) %></strong></td></tr>
  </table>

  <h3 style="margin: 18px 0 6px">Backups on the server</h3>
  <p class="muted small" style="margin-top: 0">The server makes a backup every night (kept 14 days) and one before every update (so it can be undone). They’re deleted automatically after 14 days. You can delete old ones now to free space; the 3 newest are always kept.</p>
  <% if (storage.backups.length) { %>
  <details><summary class="small"><%= storage.backups.length %> file<%= storage.backups.length === 1 ? '' : 's' %>, <%= mb(storage.parts.find((p) => p.key === 'backups').size) %></summary>
    <table class="table small"><% storage.backups.forEach((f) => { %><tr><td><code><%= f.name %></code></td><td class="muted nowrap"><span class="local-time" data-ts="<%= Math.round(f.mtime / 1000) %>"></span></td><td class="right nowrap"><%= mb(f.size) %></td></tr><% }) %></table>
  </details>
  <% } %>
  <% if (storage.backups.length > 3) { %>
  <form method="post" action="<%= A('/system/prune-backups') %>" style="margin-top: 10px" onsubmit="return confirm('Delete all server backups except the 3 newest? Download a backup first if you want to keep a copy.')">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn" type="submit">🧹 Delete old backups (free <%= mb(storage.backups.slice(3).reduce((a, f) => a + f.size, 0)) %>)</button>
  </form>
  <% } %>

  <h3 style="margin: 18px 0 6px">Memory (RAM)</h3>
  <% const m = storage.memory; const mpct = Math.round((m.total - m.available) / m.total * 100); %>
  <div class="st-bar" title="<%= mpct %>% in use"><span class="st-site" style="width: <%= Math.min(100, m.site / m.total * 100).toFixed(2) %>%"></span><span class="st-other" style="width: <%= Math.max(0, (m.total - m.available - m.site) / m.total * 100).toFixed(2) %>%"></span></div>
  <div class="st-legend small"><span><i class="st-site"></i>This site <%= mb(m.site) %></span><span><i class="st-other"></i>Other <%= mb(Math.max(0, m.total - m.available - m.site)) %></span><span><i class="st-free"></i>Available <%= mb(m.available) %> of <%= mb(m.total) %></span></div>
  <p class="hint">Sizes are re-measured every 2 minutes (or press Refresh).</p>
</section>
<section class="card" id="history">
  <h2>📝 Update history</h2>
  <p class="muted small" style="margin-top: 0">What each update changed, newest first. The release date is when the update came out; “installed” is when this site got it.</p>
  <% if (!history.length) { %><p class="muted">No updates logged yet.</p><% } %>
  <% history.slice(0, 30).forEach((e, i) => { %><%- include('partials/changelog-entry', { e, isNew: false, current: i === 0 }) %><% }) %>
  <% if (history.length > 30) { %>
  <details><summary class="small">Show <%= history.length - 30 %> older updates</summary>
    <% history.slice(30).forEach((e) => { %><%- include('partials/changelog-entry', { e, isNew: false, current: false }) %><% }) %>
  </details>
  <% } %>
</section>
<section class="card">
  <h2>📦 Novels included with updates</h2>
  <p class="muted small">Novels written for the site are added automatically when you install an update. New chapters for them arrive the same way. Your own edits are kept, and if you delete one of these novels it won’t come back.</p>
  <% if (!bundled.length) { %><p class="muted">None yet.</p><% } else { %>
  <table class="table">
    <% bundled.forEach((b) => { %>
      <tr>
        <td><% if (b.live_id) { %><a href="<%= A(`/novels/${b.live_id}/chapters`) %>"><strong><%= b.title %></strong></a><% } else { %><strong class="muted"><%= b.title %></strong> <span class="pill">deleted</span><% } %></td>
        <td class="muted small"><%= b.chapters %> chapters added</td>
        <td class="right muted small nowrap">first added <span class="local-time" data-ts="<%= b.imported_at %>"><%= u.formatDate(b.imported_at) %></span></td>
        <td class="right"><% if (b.live_id) { %><a class="btn btn-sm btn-ghost" href="<%= site(`/novel/${b.slug}`) %>" target="_blank" rel="noopener">↗ View</a><% } %></td>
      </tr>
    <% }) %>
  </table>
  <% } %>
</section>
<% if (update.running) { %>
<script>
  // Poll until the update finishes and the site comes back.
  (function poll() {
    setTimeout(function () {
      fetch('<%= A('/system/status.json') %>', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (s) {
        document.getElementById('update-log').textContent = s.log.join('\n');
        if (s.running) poll(); else location.href = '<%= A('/system?check=1') %>';
      }).catch(function () { poll(); });
    }, 2000);
  })();
</script>
<% } %>
<%- include('partials/bottom') %>
