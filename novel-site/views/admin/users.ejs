<%- include('partials/top', { title: 'Users' }) %>
<div class="stats user-stats">
  <div class="stat stat-accent" title="Everyone who opened a page in the last 10 minutes: guests and signed-in readers (bots aren't counted)"><span><%= counts.online.toLocaleString('en-US') %></span>Online now <small class="muted">(<%= counts.guests %> guest<%= counts.guests === 1 ? '' : 's' %> + <%= counts.active_now || 0 %> signed in)</small></div>
  <div class="stat" title="Signed-in accounts active in the last 10 minutes · active at any time today (UTC)"><span><%= (counts.active_now || 0).toLocaleString('en-US') %></span>Logged in &amp; active <small class="muted">(<%= (counts.active_today || 0).toLocaleString('en-US') %> today)</small></div>
  <div class="stat" title="All accounts · new today · new in the last 7 days"><span><%= counts.total.toLocaleString('en-US') %></span>Registered accounts <small class="muted">(+<%= counts.new_today || 0 %> today, +<%= counts.new_week || 0 %> this week)</small></div>
</div>
<section class="card">
  <h2>Add a team member</h2>
  <form method="post" action="<%= A('/users/new') %>" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="username" placeholder="Username" required pattern="[A-Za-z0-9_.\-]{3,24}">
    <input name="password" placeholder="Password (empty = generate)" minlength="8">
    <select name="role"><option value="translator">Translator</option><% if (user.is_owner) { %><option value="admin">Admin</option><% } %><option value="reader">Reader</option><option value="supporter">Supporter</option></select>
    <button class="btn btn-primary" type="submit">➕ Create account</button>
  </form>
  <p class="hint"><strong>Readers</strong> are normal accounts. <strong>Supporters</strong> are readers who see no ads. <strong>Translators</strong> can add novels and upload chapters for their own novels. <strong>Admins</strong> can manage everything, including users and settings. Only the <strong>👑 owner</strong> can create, change or remove admins, and nobody can touch the owner’s account.</p>
</section>
<nav class="tabs" style="margin: 0 0 12px; display: inline-flex; flex-wrap: wrap">
  <% const verified = tabCounts.verified || 0; %>
  <a href="<%= A('/users') %>" class="<%= show === 'all' ? 'on' : '' %>">All users (<%= tabCounts.all_ %>)</a>
  <a href="<%= A('/users?show=verified') %>" class="<%= show === 'verified' ? 'on' : '' %>">✅ Verified email (<%= verified %>)</a>
  <a href="<%= A('/users?show=unverified') %>" class="<%= show === 'unverified' ? 'on' : '' %>">Not verified (<%= tabCounts.all_ - verified %>)</a>
</nav>
<% if (show === 'verified') { %><p class="hint" style="margin: -4px 0 12px">Accounts that confirmed their email address by clicking the link we sent them.</p><% } %>
<% if (show === 'unverified') { %><p class="hint" style="margin: -4px 0 12px">Accounts with no email address, or one they haven’t confirmed yet.</p><% } %>
<div class="card flush">
  <% if (!users.length) { %><div class="empty-state"><p><%= show === 'verified' ? 'No verified accounts yet.' : 'Nobody here.' %></p></div><% } %>
  <table class="table table-lg">
    <thead><tr><th>User</th><th>Email</th><th>Role</th><th class="right">Novels</th><th class="right">Comments</th><th>Joined</th><th></th></tr></thead>
    <tbody>
    <% users.forEach((x) => { %>
      <tr>
        <td><strong><%= x.username %></strong><%= x.totp_enabled ? ' 🔐' : '' %><% if (x.is_owner) { %> <span class="pill pill-owner" title="Protected: only this account can manage itself">👑 Owner</span><% } %><% if (x.id === user.id) { %> <span class="pill">you</span><% } %>
          <% if (titles[x.id]) { %><div class="title-chips"><% titles[x.id].forEach((t) => { %><a class="title-chip" style="--b: <%= t.color %>" href="<%= A('/titles') %>"><%= t.icon %> <%= t.name %></a><% }) %></div><% } %></td>
        <td class="small"><% if (x.email) { %><%= x.email %> <%= x.email_verified ? '✅' : '' %><% } else { %><span class="muted">—</span><% } %></td>
        <td>
          <% const locked = x.id === user.id || x.is_owner || (!user.is_owner && x.role === 'admin'); %>
          <% if (locked) { %><span class="pill pill-<%= x.role %>"><%= x.role %></span><% } else { %>
          <form method="post" action="<%= A(`/users/${x.id}`) %>" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="role">
            <select name="role" onchange="this.form.submit()">
              <% (user.is_owner ? ['reader', 'supporter', 'translator', 'admin'] : ['reader', 'supporter', 'translator']).forEach((r) => { %><option value="<%= r %>" <%= x.role === r ? 'selected' : '' %>><%= r %></option><% }) %>
            </select>
          </form>
          <% } %>
        </td>
        <td class="right"><%= x.novel_count %></td>
        <td class="right"><%= x.comment_count %></td>
        <td class="muted small"><%= u.formatDate(x.created_at) %></td>
        <td class="right nowrap">
          <% if (x.is_owner && x.id !== user.id) { %><span class="muted small">🔒 Protected</span><% } else if (x.id !== user.id && !user.is_owner && x.role === 'admin') { %><span class="muted small">🔒 Owner only</span><% } else { %>
          <form method="post" action="<%= A(`/users/${x.id}`) %>" class="inline" onsubmit="return confirm('Generate a new random password for <%= x.username %>?')">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm" name="action" value="reset">Reset password</button>
          </form>
          <% if (x.id !== user.id) { %>
          <form method="post" action="<%= A(`/users/${x.id}`) %>" class="inline" onsubmit="return confirm('Log <%= x.username %> out on all their devices?')">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm" name="action" value="logout" title="End all their sessions">Log out</button>
          </form>
          <% if (x.totp_enabled) { %>
          <form method="post" action="<%= A(`/users/${x.id}`) %>" class="inline" onsubmit="return confirm('Turn off two-factor login for <%= x.username %>? Only do this if they lost their phone and backup codes.')">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm" name="action" value="reset2fa" title="They lost their phone">Reset 2FA</button>
          </form>
          <% } %>
          <form method="post" action="<%= A(`/users/${x.id}`) %>" class="inline" onsubmit="return confirm('Delete <%= x.username %>? Their comments are deleted; their novels are kept.')">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger" name="action" value="delete">Delete</button>
          </form>
          <% } %>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/bottom') %>
