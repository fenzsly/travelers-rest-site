<%- include('partials/head', { title: null }) %>
<%- include('partials/header') %>
<main class="wrap">
  <% if (popular.length) { %>
  <section class="block">
    <h2 class="block-title">Popular novels</h2>
    <div class="shelf">
      <% popular.forEach((n) => { %>
        <a class="shelf-item" href="/novel/<%= n.slug %>" title="<%= n.title %>">
          <%- include('partials/cover', { n }) %>
          <span class="shelf-title"><%= n.title %></span>
          <span class="shelf-meta"><%= n.chapter_count %> ch. · 👁 <%= u.compactNumber(n.views) %></span>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <div class="layout">
    <div class="content">
      <section class="block">
        <h2 class="block-title">Latest updates <a class="block-more" href="/novels?sort=updated">All novels →</a></h2>
        <% if (!updated.length) { %>
          <div class="empty">
            <p>No chapters have been published yet.</p>
            <% if (user && user.role !== 'reader' && adminUrl) { %><p><a class="btn btn-accent" href="<%= adminUrl %>">Open the admin panel to add your first novel</a></p>
            <% } else if (!user) { %><p class="muted">Site owner? <a href="/admin">Set up the admin panel</a>.</p><% } %>
          </div>
        <% } %>
        <div class="updates">
          <% updated.forEach((n) => { %>
            <div class="update-row">
              <a class="update-cover" href="/novel/<%= n.slug %>"><%- include('partials/cover', { n }) %></a>
              <div class="update-body">
                <div class="update-head">
                  <a class="update-title" href="/novel/<%= n.slug %>"><%= n.title %></a>
                  <span class="muted small"><%= u.timeAgo(n.updated_at) %></span>
                </div>
                <div class="muted small"><%= n.genre_names || '' %></div>
                <ul class="update-chapters">
                  <% n.recent.forEach((c) => { %>
                    <li><a href="/novel/<%= n.slug %>/c/<%= u.formatNumber(c.number) %>"><%= u.chapterLabel(c) %></a><span class="muted small"><%= u.timeAgo(c.created_at) %></span></li>
                  <% }) %>
                </ul>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </div>
    <%- include('partials/sidebar') %>
  </div>
</main>
<%- include('partials/footer') %>
