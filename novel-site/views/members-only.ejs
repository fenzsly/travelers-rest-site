<%- include('partials/head') %>
<%- include('partials/header') %>
<% const here = locals.currentPath || '/'; %>
<main class="wrap narrow">
  <section class="block gate">
    <div class="gate-box">
      <div class="gate-icon">🔒</div>
      <h2>Members only</h2>
      <p>This novel is only available to registered readers. Log in or create a <strong>free account</strong> to read it.</p>
      <div class="gate-actions">
        <% if (settings.allow_registration === '1') { %><a class="btn btn-accent btn-lg" href="/register?next=<%= encodeURIComponent(here) %>">Create free account</a><% } %>
        <a class="btn btn-lg" href="/login?next=<%= encodeURIComponent(here) %>">Log in</a>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
