<%- include('partials/head', { title: novel.title, description: novel.description.slice(0, 200),
  og: { type: 'book', image: novel.cover ? `${baseUrl}/uploads/covers/${novel.cover}` : null, url: `${baseUrl}/novel/${novel.slug}` },
  feed: { title: `${novel.title} — new chapters`, href: `/novel/${novel.slug}/rss.xml` } }) %>
<%- include('partials/header') %>
<main class="wrap">
  <nav class="crumbs"><a href="/">Home</a> › <a href="/novels">Novels</a> › <span><%= novel.title %></span></nav>
  <section class="block novel-head">
    <div class="novel-cover"><%- include('partials/cover', { n: novel }) %></div>
    <div class="novel-info">
      <h1 class="novel-title"><%= novel.title %></h1>
      <% if (novel.alt_titles) { %><div class="novel-alt"><%= novel.alt_titles.split('\n').join(' · ') %></div><% } %>
      <div class="rating-wrap">
        <div class="rating-line">
          <span class="stars big"><% for (let i = 1; i <= 5; i++) { %><%= i <= Math.round(novel.rating || 0) ? '★' : '☆' %><% } %></span>
          <span><strong><%= novel.rating || '—' %></strong> / 5 · <%= novel.rating_count %> vote<%= novel.rating_count === 1 ? '' : 's' %></span>
        </div>
        <% if (novel.rating_count) { %>
        <div class="rating-dist" aria-label="Rating breakdown">
          <% for (let s = 5; s >= 1; s--) { const n = dist[s] || 0; %>
            <div class="rd-row"><span><%= s %>★</span><span class="rd-bar"><span style="width: <%= Math.round(n / novel.rating_count * 100) %>%"></span></span><span class="muted"><%= n %></span></div>
          <% } %>
        </div>
        <% } %>
      </div>
      <table class="info-table">
        <% if (novel.author) { %><tr><th>Author</th><td><a href="/novels?q=<%= encodeURIComponent(novel.author) %>"><%= novel.author %></a></td></tr><% } %>
        <% if (novel.translator) { %><tr><th>Translator</th><td><a href="/user/<%= encodeURIComponent(novel.translator) %>"><%= novel.translator %></a></td></tr><% } %>
        <tr><th>Status</th><td><span class="badge badge-<%= novel.status %>"><%= u.STATUS_LABELS[novel.status] %></span></td></tr>
        <% if (novel.original_language) { %><tr><th>Language</th><td><%= novel.original_language %></td></tr><% } %>
        <% if (novel.year) { %><tr><th>Year</th><td><%= novel.year %></td></tr><% } %>
        <tr><th>Chapters</th><td><%= novel.chapter_count %> <span class="muted">(<%= u.compactNumber(words) %> words)</span></td></tr>
        <% if (latest) { %><tr><th>Updated</th><td><%= u.timeAgo(latest.released_at) %></td></tr><% } %>
        <% if (genres.length) { %><tr><th>Genres</th><td class="chips"><% genres.forEach((g) => { %><a class="chip" href="/novels?genre=<%= g.slug %>"><%= g.name %></a><% }) %></td></tr><% } %>
      </table>
      <div class="view-counter" title="Views are counted once per reader per chapter">
        <div><strong><%= novel.views.toLocaleString('en-US') %></strong><span>total views</span></div>
        <div><strong><%= novel.views_week.toLocaleString('en-US') %></strong><span>this week</span></div>
        <div><strong><%= novel.views_month.toLocaleString('en-US') %></strong><span>this month</span></div>
        <div><strong>#<%= rank %></strong><span>popularity</span></div>
        <div><strong><%= readers %></strong><span>in libraries</span></div>
      </div>
      <div class="novel-actions">
        <% if (first) { %>
          <a class="btn btn-accent btn-lg" href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(first.number) %>">Start reading</a>
          <a class="btn btn-lg continue-btn" hidden data-slug="<%= novel.slug %>" <% if (bookmark && bookmark.last_number != null) { %>data-server-last="<%= u.formatNumber(bookmark.last_number) %>"<% } %>>Continue</a>
          <a class="btn btn-lg" href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(latest.number) %>">Latest chapter</a>
        <% } %>
        <% if (user) { %>
          <details class="dropdown">
            <summary class="btn btn-lg <%= bookmark ? 'btn-on' : '' %>"><%= bookmark ? `${u.LIST_ICONS[bookmark.status]} ${u.LIST_LABELS[bookmark.status]}` : '+ Add to library' %> ▾</summary>
            <form method="post" action="/novel/<%= novel.slug %>/bookmark" class="dropdown-menu">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <% Object.entries(u.LIST_LABELS).forEach(([k, v]) => { %>
                <button type="submit" name="status" value="<%= k %>" class="<%= bookmark && bookmark.status === k ? 'on' : '' %>"><%= u.LIST_ICONS[k] %> <%= v %><% if (listCounts[k]) { %> <small><%= listCounts[k] %></small><% } %></button>
              <% }) %>
              <% if (bookmark) { %><button type="submit" name="status" value="remove" class="danger">✕ Remove from library</button><% } %>
            </form>
          </details>
        <% } else { %>
          <a class="btn btn-lg" href="/login?next=/novel/<%= novel.slug %>">+ Add to library</a>
        <% } %>
        <% if (user && (user.role === 'admin' || novel.owner_id === user.id) && adminUrl) { %>
          <a class="btn btn-lg" href="<%= adminUrl %>/novels/<%= novel.id %>/upload">⬆ Upload chapters</a>
        <% } %>
      </div>
      <% if (user) { %>
        <form method="post" action="/novel/<%= novel.slug %>/rate" class="rate-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <span class="muted small">Your rating:</span>
          <% for (let i = 1; i <= 5; i++) { %><button type="submit" name="score" value="<%= i %>" class="star-btn <%= myRating >= i ? 'on' : '' %>" title="<%= i %> star<%= i > 1 ? 's' : '' %>">★</button><% } %>
        </form>
      <% } %>
    </div>
  </section>

  <div class="layout">
    <div class="content">
      <section class="block">
        <h2 class="block-title">Description</h2>
        <div class="description collapsible" id="desc"><% novel.description.split(/\n\s*\n/).forEach((p) => { %><p><%= p %></p><% }) %></div>
        <button class="linklike" type="button" data-expand="desc" hidden>Show more ▾</button>
        <% if (novel.tags) { %><div class="chips tags"><% novel.tags.split(',').forEach((t) => { %><a class="chip chip-tag" href="/novels?tag=<%= encodeURIComponent(t.trim()) %>">#<%= t.trim() %></a><% }) %></div><% } %>
      </section>

      <section class="block tabbed" id="tabs">
        <nav class="tabs-bar">
          <a href="/novel/<%= novel.slug %>#tabs" class="<%= tab === 'chapters' ? 'on' : '' %>">📄 Chapters <small><%= novel.chapter_count %></small></a>
          <a href="/novel/<%= novel.slug %>?tab=reviews#tabs" class="<%= tab === 'reviews' ? 'on' : '' %>">✍ Reviews <small><%= reviews.length %></small></a>
          <% if (tab === 'chapters') { %><a class="tabs-extra" href="/novel/<%= novel.slug %>?order=<%= order === 'DESC' ? 'asc' : 'desc' %>#tabs"><%= order === 'DESC' ? 'Oldest first ↑' : 'Newest first ↓' %></a><% } %>
        </nav>
        <% if (tab === 'reviews') { %>
          <% if (user) { %>
            <form method="post" action="/novel/<%= novel.slug %>/review" class="review-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <textarea name="body" rows="4" minlength="20" maxlength="8000" required placeholder="What did you think? Pacing, characters, translation quality… (please keep spoilers vague)"><%= myReview ? myReview.body : '' %></textarea>
              <div class="review-actions"><span class="muted small"><%= myRating ? `Your rating: ${'★'.repeat(myRating)}` : 'Tip: rate the novel above so your stars show with your review.' %></span><button class="btn btn-accent" type="submit"><%= myReview ? 'Update review' : 'Post review' %></button></div>
            </form>
          <% } else { %><p class="muted"><a href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}?tab=reviews`) %>">Log in</a> to write a review.</p><% } %>
          <% if (!reviews.length) { %><div class="empty">No reviews yet. Be the first!</div><% } %>
          <% reviews.forEach((r) => { %>
            <article class="review">
              <div class="review-head">
                <a class="avatar" href="/user/<%= encodeURIComponent(r.username) %>" style="--h: <%= [...r.username].reduce((a, c) => a + c.charCodeAt(0), 0) % 360 %>"><%= r.username[0].toUpperCase() %></a>
                <div><a href="/user/<%= encodeURIComponent(r.username) %>"><strong><%= r.username %></strong></a><% if (r.role !== 'reader') { %> <span class="badge badge-role"><%= r.role %></span><% } %>
                  <div class="muted small"><% if (r.score) { %><span class="stars"><%= '★'.repeat(r.score) %><%= '☆'.repeat(5 - r.score) %></span> · <% } %><%= u.timeAgo(r.updated_at) %></div></div>
                <% if (user && (user.id === r.user_id || user.role === 'admin' || novel.owner_id === user.id)) { %>
                  <form method="post" action="/review/<%= r.id %>/delete" class="inline review-del" onsubmit="return confirm('Delete this review?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike small">delete</button></form>
                <% } %>
              </div>
              <div class="review-body collapsible" id="rv<%= r.id %>"><%= r.body %></div>
              <button class="linklike small" type="button" data-expand="rv<%= r.id %>" hidden>Show more ▾</button>
            </article>
          <% }) %>
        <% } else { %>
        <% if (upcoming.length) { %>
          <div class="upcoming">
            <strong>⏰ Coming soon</strong>
            <ul>
              <% upcoming.forEach((c) => { %><li><%= u.chapterLabel(c) %> <span class="muted small" data-ts="<%= c.publish_at %>"><%= u.formatDate(c.publish_at) %></span></li><% }) %>
              <% if (upcomingCount > upcoming.length) { %><li class="muted small">…and <%= upcomingCount - upcoming.length %> more scheduled</li><% } %>
            </ul>
          </div>
        <% } %>
        <% if (!chapters.length) { %><div class="empty">No chapters yet.</div><% } %>
        <ul class="chapter-list">
          <% chapters.forEach((c) => { %>
            <li><a href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(c.number) %>" data-num="<%= u.formatNumber(c.number) %>"><%= u.chapterLabel(c) %></a><span class="muted small"><% if (u.isRecent(c.released_at)) { %><span class="new-badge">NEW</span> <% } %><%= u.formatDate(c.released_at) %></span></li>
          <% }) %>
        </ul>
        <%- include('partials/pager', { pager, base: `/novel/${novel.slug}`, hash: '#tabs' }) %>
        <% } %>
      </section>
    </div>
    <aside class="sidebar">
      <section class="block">
        <h2 class="block-title">Share &amp; follow</h2>
        <div class="share-row">
          <button type="button" class="btn btn-sm" data-copy="<%= baseUrl %>/novel/<%= novel.slug %>">🔗 Copy link</button>
          <a class="btn btn-sm" href="/novel/<%= novel.slug %>/rss.xml" title="Get new chapters in your RSS reader">📡 RSS</a>
          <a class="btn btn-sm" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(`Reading ${novel.title}`) %>&url=<%= encodeURIComponent(`${baseUrl}/novel/${novel.slug}`) %>" target="_blank" rel="noopener">𝕏 Share</a>
        </div>
      </section>
      <% if (similar.length) { %>
      <section class="block">
        <h2 class="block-title">You may also like</h2>
        <ul class="mini-list">
          <% similar.forEach((n) => { %>
            <li><a class="mini-cover" href="/novel/<%= n.slug %>"><%- include('partials/cover', { n }) %></a>
              <div><a href="/novel/<%= n.slug %>"><%= n.title %></a><div class="muted small"><%= n.chapter_count %> ch. · 👁 <%= u.compactNumber(n.views) %><%= n.rating ? ` · ★ ${n.rating}` : '' %></div></div></li>
          <% }) %>
        </ul>
      </section>
      <% } %>
      <% if (genres.length) { %>
      <section class="block">
        <h2 class="block-title">Browse genres</h2>
        <div class="genre-cloud"><% genres.forEach((g) => { %><a href="/novels?genre=<%= g.slug %>">More <%= g.name %></a><% }) %></div>
      </section>
      <% } %>
    </aside>
  </div>
</main>
<%- include('partials/footer') %>
