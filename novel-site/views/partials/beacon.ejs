<%# Counts this visit (and chapter view) once the page has really been open in a browser for a moment.
    Scraping scripts only download pages and never run this, so they don't inflate the stats. %>
<script>
(function () {
  var sent = false;
  function send() {
    if (sent || document.visibilityState === 'hidden') return;
    sent = true;
    var d = new URLSearchParams({ p: location.pathname<% if (typeof beaconChapter !== 'undefined' && beaconChapter) { %>, c: '<%= beaconChapter %>'<% } %> });
    try { if (!(navigator.sendBeacon && navigator.sendBeacon('/beacon', d))) fetch('/beacon', { method: 'POST', body: d, keepalive: true, credentials: 'same-origin' }); } catch (e) {}
  }
  setTimeout(function () {
    send();
    if (!sent) document.addEventListener('visibilitychange', send);
  }, 1500);
})();
</script>
