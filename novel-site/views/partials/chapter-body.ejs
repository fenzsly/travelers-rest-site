<%# The chapter's text, with one in-article ad in long chapters (see partials/ad). Used by the reader and the browser-check loader. %>
<% const paras = chapter.content.split('</p>'); const mid = paras.length >= 30 ? Math.floor(paras.length * 0.6) : 0; %>
<% if (mid) { %><%- paras.slice(0, mid).join('</p>') + '</p>' %><%- include('ad', { place: 'chapter_mid' }) %><%- paras.slice(mid).join('</p>') %><% } else { %><%- chapter.content %><% } %>
