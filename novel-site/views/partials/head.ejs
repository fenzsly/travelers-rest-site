<!doctype html>
<html lang="en" data-theme="<%= settings.default_theme === 'light' ? 'light' : 'dark' %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%- include('seo-meta', { seo: typeof seo !== 'undefined' ? seo : {} }) %>
<link rel="stylesheet" href="/static/css/site.css">
<script>
  // Apply the saved site theme before first paint.
  try { var t = localStorage.getItem('site-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
</script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
