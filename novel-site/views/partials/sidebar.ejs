<aside class="sidebar">
  <% if (typeof latestComments !== 'undefined' && latestComments.length) { %>
  <section class="block">
    <h2 class="block-title">Latest comments</h2>
    <ul class="latest-comments">
      <% latestComments.forEach((c) => { const link = c.kind === 'review' ? `/novel/${c.slug}?tab=reviews#tabs` : `/novel/${c.slug}/c/${u.formatNumber(c.number)}#comments`; %>
        <li>
          <div class="lc-head">
            <a class="avatar avatar-sm" href="/user/<%= encodeURIComponent(c.username) %>" style="--h: <%= [...c.username].reduce((a, ch) => a + ch.charCodeAt(0), 0) % 360 %>"><%= c.username[0].toUpperCase() %></a>
            <a href="/user/<%= encodeURIComponent(c.username) %>"><strong><%= c.username %></strong></a>
            <span class="muted small"><%= u.timeAgo(c.created_at) %></span>
          </div>
          <a class="lc-body" href="<%= link %>"><%= c.body.length > 140 ? c.body.slice(0, 140).trim() + '…' : c.body %></a>
          <a class="lc-where small" href="<%= link %>"><%= c.kind === 'review' ? '✍ Review of ' : '💬 ' %><%= c.novel_title %><%= c.kind === 'comment' ? ` · Ch. ${u.formatNumber(c.number)}` : '' %></a>
        </li>
      <% }) %>
    </ul>
  </section>
  <% } %>
  <% if (typeof trending !== 'undefined' && trending.length) { %>
  <section class="block">
    <h2 class="block-title">Trending this week <a class="block-more" href="/novels?sort=trending">All →</a></h2>
    <ol class="toplist">
      <% trending.forEach((n, i) => { %>
        <li><span class="rank"><%= i + 1 %></span><a href="/novel/<%= n.slug %>"><%= n.title %></a><span class="muted small" title="Views in the last 7 days">👁 <%= u.compactNumber(n.views_week) %></span></li>
      <% }) %>
    </ol>
  </section>
  <% } %>
  <% if (typeof topRequests !== 'undefined') { %>
  <section class="block">
    <h2 class="block-title">Most requested this week <a class="block-more" href="/requests">All →</a></h2>
    <% if (topRequests.length) { %>
    <ol class="toplist">
      <% topRequests.forEach((r, i) => { %>
        <li><span class="rank"><%= i + 1 %></span><a href="/requests#r<%= r.id %>"><%= r.title %></a><span class="muted small req-votes" title="Votes in the last 7 days">👍 <%= r.week_votes %></span></li>
      <% }) %>
    </ol>
    <% } else { %><p class="muted small">No votes yet this week.</p><% } %>
    <a class="btn btn-sm btn-block" href="/requests#request-form">＋ Request a novel</a>
  </section>
  <% } %>
  <% if (typeof topRated !== 'undefined' && topRated.length) { %>
  <section class="block">
    <h2 class="block-title">Top rated</h2>
    <ol class="toplist">
      <% topRated.forEach((n, i) => { %>
        <li><span class="rank"><%= i + 1 %></span><a href="/novel/<%= n.slug %>"><%= n.title %></a><span class="stars">★ <%= n.rating %></span></li>
      <% }) %>
    </ol>
  </section>
  <% } %>
  <% if (typeof fresh !== 'undefined' && fresh.length) { %>
  <section class="block">
    <h2 class="block-title">New novels</h2>
    <ul class="mini-list">
      <% fresh.forEach((n) => { %>
        <li><a class="mini-cover" href="/novel/<%= n.slug %>"><%- include('cover', { n }) %></a>
          <div><a href="/novel/<%= n.slug %>"><%= n.title %></a><div class="muted small"><%= n.chapter_count %> chapters · <%= u.timeAgo(n.created_at) %></div></div></li>
      <% }) %>
    </ul>
  </section>
  <% } %>
  <% if (typeof totals !== 'undefined') { %>
  <section class="block site-stats">
    <div><strong><%= totals.novels %></strong><span>novels</span></div>
    <div><strong><%= u.compactNumber(totals.chapters) %></strong><span>chapters</span></div>
    <div><strong><%= u.compactNumber(totals.views) %></strong><span>reads</span></div>
  </section>
  <% } %>
  <section class="block">
    <h2 class="block-title">Genres</h2>
    <div class="genre-cloud">
      <% genres.forEach((g) => { %><a href="/novels?genre=<%= g.slug %>" class="<%= typeof genre !== 'undefined' && genre === g.slug ? 'active' : '' %>"><%= g.name %><% if (g.novel_count) { %> <small><%= g.novel_count %></small><% } %></a><% }) %>
    </div>
  </section>
</aside>
