<article class="story">
  <a class="story-cover" href="/novel/<%= n.slug %>"><%- include('cover', { n }) %></a>
  <div class="story-body">
    <h3 class="story-title"><a href="/novel/<%= n.slug %>"><%= n.title %></a></h3>
    <% if (n.alt_titles) { %><div class="story-alt"><%= n.alt_titles.split('\n')[0] %></div><% } %>
    <div class="story-meta">
      <span class="badge badge-<%= n.status %>"><%= u.STATUS_LABELS[n.status] %></span>
      <% if (n.rating) { %><span class="stars" title="<%= n.rating %> / 5 (<%= n.rating_count %> votes)">★ <%= n.rating %></span><% } %>
      <span>📄 <%= n.chapter_count %> ch.</span>
      <span>👁 <%= u.compactNumber(n.views) %></span>
      <% if (n.author) { %><span>✍ <%= n.author %></span><% } %>
    </div>
    <% if (n.genre_names) { %><div class="story-genres"><%= n.genre_names %></div><% } %>
    <p class="story-desc"><%= n.description.slice(0, 300) %><%= n.description.length > 300 ? '…' : '' %></p>
    <div class="story-foot">
      <% if (n.latest_number != null) { %><a href="/novel/<%= n.slug %>/c/<%= u.formatNumber(n.latest_number) %>">Latest: Chapter <%= u.formatNumber(n.latest_number) %></a><% } %>
      <span class="muted">Updated <%= u.timeAgo(n.updated_at) %></span>
    </div>
  </div>
</article>
