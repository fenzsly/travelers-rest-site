<!doctype html>
<html lang="en" data-theme="<%= (user && user.prefs.theme) || (settings.default_theme === 'light' ? 'light' : 'dark') %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<%- include('partials/seo-meta', { seo }) %>
<link rel="stylesheet" href="<%= asset('/static/css/site.css') %>">
<link rel="stylesheet" href="<%= asset('/static/css/reader.css') %>">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&display=swap">
<% if (user) { %><meta name="csrf" content="<%= csrf %>"><% } %>
<script>
  window.ACCOUNT = <%- user ? u.jsonScript({ prefs: user.prefs }) : 'null' %>;
  // Phones and tablets: immersive reading (controls appear on double-tap). Decided before first paint.
  try {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches || window.innerWidth <= 720) document.documentElement.classList.add('immersive');
  } catch (e) {}
  // Apply saved reader preferences before first paint (no flash of the wrong theme).
  // Settings saved on the account win, so they follow the reader to every device.
  try {
    var p = JSON.parse(localStorage.getItem('reader-prefs') || '{}');
    if (window.ACCOUNT) {
      var a = window.ACCOUNT.prefs || {};
      Object.keys(a).forEach(function (k) { if (k !== 'theme') p[k] = a[k]; });
      localStorage.setItem('reader-prefs', JSON.stringify(p));
      if (a.theme) localStorage.setItem('site-theme', a.theme);
    }
    var d = document.documentElement;
    d.dataset.theme = p.theme || localStorage.getItem('site-theme') || d.dataset.theme || 'dark';
    d.dataset.rtheme = p.rtheme || '';
    var phone = d.classList.contains('immersive');
    d.style.setProperty('--r-size', (p.size || (phone ? 20 : 19)) + 'px');
    d.style.setProperty('--r-line', p.line || (phone ? 1.9 : 1.8));
    d.style.setProperty('--r-width', (p.width || 800) + 'px');
    d.dataset.font = p.font || 'serif';
    d.dataset.align = p.align || 'left';
  } catch (e) {}
</script>
</head>
<body class="reader-page">
<div class="progress"><div class="progress-bar" id="progress"></div></div>
<% const dashLabel = `Chapter ${u.formatNumber(chapter.number)}${chapter.title ? ` — ${chapter.title}` : ''}`; %>
<header class="reader-bar" id="reader-bar">
  <div class="reader-bar-inner">
    <a class="rb-back" href="/novel/<%= novel.slug %>" aria-label="Back to <%= novel.title %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></a>
    <a class="rb-home" href="/" title="Home">📖</a>
    <a class="rb-novel" href="/novel/<%= novel.slug %>"><%= novel.title %></a>
    <span class="rb-chapter muted"><%= u.chapterLabel(chapter) %></span>
    <span class="rb-title"><%= dashLabel %></span>
    <div class="rb-actions">
      <div class="rb-nav" role="group" aria-label="Chapters">
        <% if (prev) { %><a class="rb-step" href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(prev.number) %>" rel="prev" title="Previous chapter (←): <%= u.chapterLabel(prev) %>" aria-label="Previous chapter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6"/></svg></a>
        <% } else { %><span class="rb-step off" aria-disabled="true" title="This is the first chapter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6"/></svg></span><% } %>
        <% if (next) { %><a class="rb-step" href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(next.number) %>" rel="next" title="Next chapter (→): <%= u.chapterLabel(next) %>" aria-label="Next chapter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6l6 6-6 6"/></svg></a>
        <% } else { %><span class="rb-step off" aria-disabled="true" title="No next chapter yet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6l6 6-6 6"/></svg></span><% } %>
      </div>
      <button type="button" class="icon-btn" data-open="toc" title="Contents (C)" aria-label="Contents"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h12M4 17h14"/></svg></button>
      <button type="button" class="icon-btn" data-open="settings" title="Reader settings (S)" aria-label="Reader settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h9M17 8h3M4 16h3M11 16h9"/><circle cx="15" cy="8" r="2"/><circle cx="9" cy="16" r="2"/></svg></button>
    </div>
  </div>
  <div class="rb-progress"><span id="rb-fill"></span></div>
</header>

<div class="tap-hint" id="tap-hint" hidden>Double-tap anywhere to show the menu</div>

<main class="reader">
  <nav class="crumbs"><a href="/">Home</a> › <a href="/novel/<%= novel.slug %>"><%= novel.title %></a> › <span>Chapter <%= u.formatNumber(chapter.number) %></span></nav>
  <%- include('partials/chapter-nav', { where: 'top' }) %>
  <article class="chapter" id="chapter" data-slug="<%= novel.slug %>" data-num="<%= u.formatNumber(chapter.number) %>" data-novel-title="<%= novel.title %>" data-chapter-title="<%= chapter.title %>">
    <div class="chapter-eyebrow">Chapter <%= u.formatNumber(chapter.number) %> of <%= u.formatNumber(novel.latest_number ?? chapter.number) %></div>
    <h1 class="chapter-title"><span class="ct-full"><%= u.chapterLabel(chapter) %></span><span class="ct-dash"><%= dashLabel %></span></h1>
    <div class="chapter-meta muted small"><%= u.formatDate(chapter.released_at) %> · 👁 <%= chapter.views.toLocaleString("en-US") %> views · <%= chapter.word_count.toLocaleString('en-US') %> words · ~<%= Math.max(1, Math.round(chapter.word_count / 230)) %> min read · chapter <%= position %> of <%= novel.chapter_count %></div>
    <% if (pendingText) { %>
    <div class="chapter-text" id="chapter-text" data-pending="<%= humanChallenge %>" data-url="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/text" data-csrf="<%= csrf %>">
      <div class="text-loading" aria-live="polite"><span></span><span></span><span></span></div>
      <noscript><p class="muted">Please turn on JavaScript to read this chapter, or <a href="/login">log in</a>.</p></noscript>
    </div>
    <script>
    // Browser check: prove this is a real browser, then load the chapter text (once per browser).
    (function () {
      var box = document.getElementById('chapter-text');
      function fail() { box.innerHTML = '<p class="muted">Couldn’t load the chapter. <a href="">Reload the page</a>.</p>'; }
      setTimeout(function () {
        fetch('/human', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': box.dataset.csrf },
          body: 'answer=' + encodeURIComponent(box.dataset.pending) })
          .then(function (r) { if (!r.ok) throw 0; return fetch(box.dataset.url, { credentials: 'same-origin' }); })
          .then(function (r) { if (!r.ok) throw 0; return r.json(); })
          .then(function (d) {
            box.innerHTML = d.html;
            box.removeAttribute('data-pending');
            box.querySelectorAll('ins.adsbygoogle').forEach(function () { try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {} });
          })
          .catch(fail);
      }, 180);
    })();
    </script>
    <% } else { %>
    <div class="chapter-text" id="chapter-text"><%- include('partials/chapter-body', { chapter }) %></div>
    <% } %>
  </article>
  <section class="reactions" id="reactions" data-url="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/react">
    <span class="muted small">How was this chapter?</span>
    <% Object.entries(u.REACTIONS).forEach(([k, e]) => { %>
      <% if (user) { %>
        <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/react" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" name="emoji" value="<%= k %>" class="react <%= myReaction === k ? 'on' : '' %>" data-emoji="<%= k %>" title="<%= k %>"><%= e %> <span><%= reactionCounts[k] || '' %></span></button>
        </form>
      <% } else { %>
        <a class="react" href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#reactions`) %>" title="Log in to react"><%= e %> <span><%= reactionCounts[k] || '' %></span></a>
      <% } %>
    <% }) %>
    <% if (user) { %><button type="button" class="report-btn" data-open="report" title="Report a typo or problem in this chapter">⚑ Report an error</button><% } else { %><a class="report-btn" href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#report-error`) %>" title="Log in to report an error">⚑ Report an error</a><% } %>
  </section>
  <%- include('partials/chapter-nav', { where: 'bottom' }) %>
  <%- include('partials/ad', { place: 'chapter_end' }) %>
  <% if (!next) { %>
    <div class="end-note">
      <% if (upcoming) { %>⏰ Chapter <%= u.formatNumber(upcoming.number) %> will be released <strong data-ts="<%= upcoming.publish_at %>"><%= u.formatDate(upcoming.publish_at) %></strong>.
      <% } else { %>You're all caught up! <% if (novel.status === 'completed') { %>This novel is complete.<% } else { %>New chapters will appear here as they're translated.<% } %><% } %>
      <% if (!bookmarked) { %><br><span class="muted small">Add it to your library to see when new chapters arrive.</span><% } %>
    </div>
  <% } %>
  <p class="muted small center keys-tip">Tip: use ← → arrow keys to switch chapters.</p>


  <section class="report-error" id="report-error">
    <details>
      <summary>🛠 Found an error in this chapter? <span class="muted small">Typo, wrong name, missing text…</span></summary>
      <% if (user) { %>
      <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/report" class="report-form" data-report>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>What's wrong?
          <select name="kind"><% Object.entries(u.REPORT_KINDS).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select>
        </label>
        <label>Text in question <textarea name="quote" rows="2" maxlength="1000" placeholder="(optional) copy the sentence with the error"></textarea></label>
        <label>Details <textarea name="message" rows="2" maxlength="2000" placeholder="e.g. “Lin Feng” is called “Lin Fang” here"></textarea></label>
        <button class="btn btn-accent" type="submit">Send report</button>
        <p class="report-done" hidden>✓ Thanks! Sent to the team to fix.</p>
      </form>
      <% } else { %>
      <p class="muted small"><a href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#report-error`) %>">Log in</a> or <a href="/register?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#report-error`) %>">sign up</a> to report errors.</p>
      <% } %>
    </details>
  </section>
  <% if (settings.comments_enabled === '1') { %>
  <section class="comments" id="comments">
    <h2>Comments <span class="muted small"><%= comments.reduce((n, c) => n + 1 + c.replies.length, 0) %></span></h2>
    <% if (user) { %>
      <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/comment" class="comment-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="body" rows="3" maxlength="4000" placeholder="Share your thoughts on this chapter… (please mark spoilers)" required></textarea>
        <button class="btn btn-accent" type="submit">Post comment</button>
      </form>
    <% } else { %>
      <p class="muted"><a href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#comments`) %>">Log in</a> to comment.</p>
    <% } %>
    <% const commentHtml = (c, root) => { %>
        <li class="comment" id="c<%= c.id %>">
          <div class="comment-head"><a href="/user/<%= encodeURIComponent(c.username) %>"><strong><%= c.username %></strong></a> <%- include('partials/badges', { role: c.role, titles: titles[c.user_id] }) %> <span class="muted small"><%= u.timeAgo(c.created_at) %></span></div>
          <div class="comment-body"><%= c.body %></div>
          <div class="comment-actions">
            <% if (user) { %><a class="small" href="?reply=<%= c.id %>#thread-<%= root.id %>" rel="nofollow" data-reply="<%= c.id %>" data-root="<%= root.id %>" data-name="<%= c.username %>">↩ Reply</a>
            <% } else { %><a class="small" href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#c${c.id}`) %>">↩ Reply</a><% } %>
            <% if (user && (user.id === c.user_id || user.role === 'admin' || novel.owner_id === user.id)) { %>
              <form method="post" action="/comment/<%= c.id %>/delete" class="inline" onsubmit="return confirm('<%= c.parent_id ? 'Delete this reply?' : 'Delete this comment and its replies?' %>')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike small muted" type="submit">delete</button></form>
            <% } %>
          </div>
        </li>
    <% } %>
    <% const replyTo = Number(query.reply) || 0; %>
    <ul class="comment-list">
      <% comments.forEach((c) => { const target = replyTo && (c.id === replyTo ? c : c.replies.find((r) => r.id === replyTo)); %>
        <% commentHtml(c, c) %>
        <% if (c.replies.length || user) { %>
          <li class="comment-thread" id="thread-<%= c.id %>"<%= c.replies.length || target ? '' : ' hidden' %>>
            <% if (c.replies.length > 3) { %><button type="button" class="linklike small thread-toggle" data-thread="<%= c.id %>">▾ Hide <%= c.replies.length %> replies</button><% } %>
            <ul class="reply-list">
              <% c.replies.forEach((r) => { commentHtml(r, c); }) %>
            </ul>
            <% if (user) { %>
              <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/comment" class="comment-form reply-form"<%= target ? '' : ' hidden' %>>
                <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="parent_id" value="<%= target ? target.id : c.id %>">
                <textarea name="body" rows="2" maxlength="4000" required placeholder="Write a reply…"<%= target ? ' autofocus' : '' %>><%= target && target.id !== c.id ? `@${target.username} ` : '' %></textarea>
                <div class="reply-form-actions"><button type="button" class="btn btn-sm" data-cancel-reply>Cancel</button><button class="btn btn-sm btn-accent" type="submit">Reply</button></div>
              </form>
            <% } %>
          </li>
        <% } %>
      <% }) %>
    </ul>
  </section>
  <% } %>
  <% if (next) { %>
  <%# Scroll past the end to open the next chapter: a normal page load that starts at the top (not an endless page). %>
  <a class="next-pull" id="next-pull" href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(next.number) %>">
    <span class="np-hint">Keep scrolling for the next chapter</span>
    <span class="np-title"><%= u.chapterLabel(next) %></span>
    <span class="np-bar"><span></span></span>
  </a>
  <div class="next-pull-space" id="next-pull-space" aria-hidden="true"></div>
  <% } %>
</main>

<div class="panel" id="panel-toc" hidden>
  <div class="panel-inner">
    <div class="panel-head"><strong>Contents</strong><button class="icon-btn" data-close>✕</button></div>
    <input type="search" class="toc-filter" placeholder="Jump to chapter number or search title…">
    <ul class="toc-list" id="toc-list"><li class="muted">Loading…</li></ul>
  </div>
</div>

<% if (user) { %>
<div class="panel" id="panel-report" hidden>
  <div class="panel-inner">
    <div class="panel-head"><strong>Report a problem</strong><button class="icon-btn" data-close>✕</button></div>
    <p class="muted small">Spotted a typo, a wrong name or missing text? Tell the <%= novel.is_original ? 'author' : 'translator' %>. Tip: select the text in the chapter first and it's quoted here automatically.</p>
    <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/report" class="report-form" id="report-form" data-report>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>What's wrong?
        <select name="kind"><% Object.entries(u.REPORT_KINDS).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select>
      </label>
      <label>Text in question <textarea name="quote" rows="3" maxlength="1000" id="report-quote" placeholder="(optional) the sentence with the problem"></textarea></label>
      <label>Details <textarea name="message" rows="3" maxlength="2000" placeholder="e.g. “Lin Feng” is called “Lin Fang” here"></textarea></label>
      <button class="btn btn-accent btn-block" type="submit">Send report</button>
      <p class="report-done" hidden>✓ Thanks! The <%= novel.is_original ? 'author' : 'translator' %> has been notified.</p>
    </form>
  </div>
</div>
<% } %>

<div class="panel" id="panel-settings" hidden>
  <div class="panel-inner">
    <div class="panel-head"><strong>Reader settings</strong><button class="icon-btn" data-close>✕</button></div>
    <div class="setting">
      <label>Theme</label>
      <div class="swatches">
        <button data-rtheme="" class="sw sw-auto" title="Same as the site (dark/light)">A</button>
        <button data-rtheme="light" class="sw sw-light" title="Light">A</button>
        <button data-rtheme="sepia" class="sw sw-sepia" title="Sepia">A</button>
        <button data-rtheme="green" class="sw sw-green" title="Soft green">A</button>
        <button data-rtheme="dark" class="sw sw-dark" title="Dark">A</button>
        <button data-rtheme="black" class="sw sw-black" title="OLED black">A</button>
      </div>
    </div>
    <div class="setting">
      <label>Font</label>
      <div class="seg">
        <button data-font="serif">Serif</button><button data-font="sans">Sans</button><button data-font="mono">Mono</button><button data-font="dyslexic">Readable</button>
      </div>
    </div>
    <div class="setting"><label for="s-size">Text size <output id="o-size"></output></label><input type="range" id="s-size" min="13" max="32" step="1"></div>
    <div class="setting"><label for="s-line">Line spacing <output id="o-line"></output></label><input type="range" id="s-line" min="1.2" max="2.6" step="0.1"></div>
    <div class="setting setting-width"><label for="s-width">Page width <output id="o-width"></output></label><input type="range" id="s-width" min="500" max="1400" step="20"></div>
    <div class="setting">
      <label>Alignment</label>
      <div class="seg"><button data-align="left">Left</button><button data-align="justify">Justify</button></div>
    </div>
    <div class="setting">
      <label>Scroll past the end to open the next chapter</label>
      <div class="seg"><button data-autonext="on">On</button><button data-autonext="off">Off</button></div>
    </div>
    <button class="btn btn-block" id="reset-prefs" type="button">Reset to defaults</button>
  </div>
</div>

<script src="<%= asset('/static/js/reader.js') %>" defer></script>
<%- include('partials/beacon', { beaconChapter: chapter.id }) %>
</body>
</html>
