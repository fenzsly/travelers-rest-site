<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= u.chapterLabel(chapter) %> — <%= novel.title %> — <%= settings.site_name %></title>
<meta name="description" content="<%= novel.title %>: <%= u.chapterLabel(chapter) %>">
<meta property="og:site_name" content="<%= settings.site_name %>">
<meta property="og:type" content="article">
<meta property="og:title" content="<%= novel.title %> — <%= u.chapterLabel(chapter) %>">
<meta property="og:description" content="<%= novel.description.slice(0, 200) %>">
<meta property="og:url" content="<%= baseUrl %>/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>">
<% if (novel.cover) { %><meta property="og:image" content="<%= baseUrl %>/uploads/covers/<%= novel.cover %>"><% } %>
<link rel="canonical" href="<%= baseUrl %>/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📖</text></svg>">
<link rel="stylesheet" href="/static/css/site.css">
<link rel="stylesheet" href="/static/css/reader.css">
<% if (prev) { %><link rel="prev" href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(prev.number) %>"><% } %>
<% if (next) { %><link rel="next" href="/novel/<%= novel.slug %>/c/<%= u.formatNumber(next.number) %>"><% } %>
<script>
  // Apply saved reader preferences before first paint (no flash of the wrong theme).
  try {
    var p = JSON.parse(localStorage.getItem('reader-prefs') || '{}');
    var d = document.documentElement;
    d.dataset.theme = p.theme || localStorage.getItem('site-theme') || 'light';
    d.dataset.rtheme = p.rtheme || '';
    d.style.setProperty('--r-size', (p.size || 19) + 'px');
    d.style.setProperty('--r-line', p.line || 1.8);
    d.style.setProperty('--r-width', (p.width || 800) + 'px');
    d.dataset.font = p.font || 'serif';
    d.dataset.align = p.align || 'left';
  } catch (e) {}
</script>
</head>
<body class="reader-page">
<div class="progress"><div class="progress-bar" id="progress"></div></div>
<header class="reader-bar" id="reader-bar">
  <div class="reader-bar-inner">
    <a class="rb-home" href="/" title="Home">📖</a>
    <a class="rb-novel" href="/novel/<%= novel.slug %>"><%= novel.title %></a>
    <span class="rb-chapter muted"><%= u.chapterLabel(chapter) %></span>
    <div class="rb-actions">
      <button type="button" class="icon-btn" data-open="toc" title="Contents (C)">☰</button>
      <button type="button" class="icon-btn" data-open="settings" title="Reader settings (S)">Aa</button>
    </div>
  </div>
</header>

<main class="reader">
  <nav class="crumbs"><a href="/">Home</a> › <a href="/novel/<%= novel.slug %>"><%= novel.title %></a> › <span>Chapter <%= u.formatNumber(chapter.number) %></span></nav>
  <%- include('partials/chapter-nav', { where: 'top' }) %>
  <article class="chapter" id="chapter" data-slug="<%= novel.slug %>" data-num="<%= u.formatNumber(chapter.number) %>" data-novel-title="<%= novel.title %>" data-chapter-title="<%= chapter.title %>">
    <h1 class="chapter-title"><%= u.chapterLabel(chapter) %></h1>
    <div class="chapter-meta muted small"><%= u.formatDate(chapter.released_at) %> · 👁 <%= chapter.views.toLocaleString("en-US") %> views · <%= chapter.word_count.toLocaleString('en-US') %> words · ~<%= Math.max(1, Math.round(chapter.word_count / 230)) %> min read · chapter <%= position %> of <%= novel.chapter_count %></div>
    <div class="chapter-text" id="chapter-text"><%- chapter.content %></div>
  </article>
  <section class="reactions" id="reactions" data-url="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/react">
    <span class="muted small">How was this chapter?</span>
    <% Object.entries(u.REACTIONS).forEach(([k, e]) => { %>
      <% if (user) { %>
        <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/react" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" name="emoji" value="<%= k %>" class="react <%= myReaction === k ? 'on' : '' %>" data-emoji="<%= k %>" title="<%= k %>"><%= e %> <span><%= reactionCounts[k] || '' %></span></button>
        </form>
      <% } else { %>
        <a class="react" href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#reactions`) %>" title="Log in to react"><%= e %> <span><%= reactionCounts[k] || '' %></span></a>
      <% } %>
    <% }) %>
    <button type="button" class="report-btn" data-open="report" title="Report a typo or problem in this chapter">⚑ Report a problem</button>
  </section>
  <%- include('partials/chapter-nav', { where: 'bottom' }) %>
  <% if (!next) { %>
    <div class="end-note">
      <% if (upcoming) { %>⏰ Chapter <%= u.formatNumber(upcoming.number) %> will be released <strong data-ts="<%= upcoming.publish_at %>"><%= u.formatDate(upcoming.publish_at) %></strong>.
      <% } else { %>You're all caught up! <% if (novel.status === 'completed') { %>This novel is complete.<% } else { %>New chapters will appear here as they're translated.<% } %><% } %>
      <% if (!bookmarked) { %><br><span class="muted small">Add it to your library to see when new chapters arrive.</span><% } %>
    </div>
  <% } %>
  <p class="muted small center">Tip: use ← → arrow keys to switch chapters.</p>

  <% if (settings.comments_enabled === '1') { %>
  <section class="comments" id="comments">
    <h2>Comments <span class="muted small"><%= comments.length %></span></h2>
    <% if (user) { %>
      <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/comment" class="comment-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="body" rows="3" maxlength="4000" placeholder="Share your thoughts on this chapter… (please mark spoilers)" required></textarea>
        <button class="btn btn-accent" type="submit">Post comment</button>
      </form>
    <% } else { %>
      <p class="muted"><a href="/login?next=<%= encodeURIComponent(`/novel/${novel.slug}/c/${u.formatNumber(chapter.number)}#comments`) %>">Log in</a> to comment.</p>
    <% } %>
    <ul class="comment-list">
      <% comments.forEach((c) => { %>
        <li class="comment">
          <div class="comment-head"><a href="/user/<%= encodeURIComponent(c.username) %>"><strong><%= c.username %></strong></a><% if (c.role !== 'reader') { %> <span class="badge badge-role"><%= c.role %></span><% } %> <span class="muted small"><%= u.timeAgo(c.created_at) %></span>
            <% if (user && (user.id === c.user_id || user.role === 'admin' || novel.owner_id === user.id)) { %>
              <form method="post" action="/comment/<%= c.id %>/delete" class="inline" onsubmit="return confirm('Delete this comment?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike small" type="submit">delete</button></form>
            <% } %>
          </div>
          <div class="comment-body"><%= c.body %></div>
        </li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</main>

<div class="panel" id="panel-toc" hidden>
  <div class="panel-inner">
    <div class="panel-head"><strong>Contents</strong><button class="icon-btn" data-close>✕</button></div>
    <input type="search" class="toc-filter" placeholder="Jump to chapter number or search title…">
    <ul class="toc-list" id="toc-list"><li class="muted">Loading…</li></ul>
  </div>
</div>

<div class="panel" id="panel-report" hidden>
  <div class="panel-inner">
    <div class="panel-head"><strong>Report a problem</strong><button class="icon-btn" data-close>✕</button></div>
    <p class="muted small">Spotted a typo, a wrong name or missing text? Tell the translator. Tip: select the text in the chapter first and it's quoted here automatically.</p>
    <form method="post" action="/novel/<%= novel.slug %>/c/<%= u.formatNumber(chapter.number) %>/report" class="report-form" id="report-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>What's wrong?
        <select name="kind"><% Object.entries(u.REPORT_KINDS).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select>
      </label>
      <label>Text in question <textarea name="quote" rows="3" maxlength="1000" id="report-quote" placeholder="(optional) the sentence with the problem"></textarea></label>
      <label>Details <textarea name="message" rows="3" maxlength="2000" placeholder="e.g. “Lin Feng” is called “Lin Fang” here"></textarea></label>
      <button class="btn btn-accent btn-block" type="submit">Send report</button>
      <p class="report-done" hidden>✓ Thanks! The translator has been notified.</p>
    </form>
  </div>
</div>

<div class="panel" id="panel-settings" hidden>
  <div class="panel-inner">
    <div class="panel-head"><strong>Reader settings</strong><button class="icon-btn" data-close>✕</button></div>
    <div class="setting">
      <label>Theme</label>
      <div class="swatches">
        <button data-rtheme="" class="sw sw-light" title="Light">A</button>
        <button data-rtheme="sepia" class="sw sw-sepia" title="Sepia">A</button>
        <button data-rtheme="green" class="sw sw-green" title="Soft green">A</button>
        <button data-rtheme="dark" class="sw sw-dark" title="Dark">A</button>
        <button data-rtheme="black" class="sw sw-black" title="OLED black">A</button>
      </div>
    </div>
    <div class="setting">
      <label>Font</label>
      <div class="seg">
        <button data-font="serif">Serif</button><button data-font="sans">Sans</button><button data-font="mono">Mono</button><button data-font="dyslexic">Readable</button>
      </div>
    </div>
    <div class="setting"><label for="s-size">Text size <output id="o-size"></output></label><input type="range" id="s-size" min="13" max="32" step="1"></div>
    <div class="setting"><label for="s-line">Line spacing <output id="o-line"></output></label><input type="range" id="s-line" min="1.2" max="2.6" step="0.1"></div>
    <div class="setting"><label for="s-width">Page width <output id="o-width"></output></label><input type="range" id="s-width" min="500" max="1400" step="20"></div>
    <div class="setting">
      <label>Alignment</label>
      <div class="seg"><button data-align="left">Left</button><button data-align="justify">Justify</button></div>
    </div>
    <button class="btn btn-block" id="reset-prefs" type="button">Reset to defaults</button>
  </div>
</div>

<script src="/static/js/reader.js" defer></script>
</body>
</html>
